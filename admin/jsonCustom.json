{
  "i18n": true,
  "type": "panel",
  "items": {
    "_basicSettings": {
      "newLine": true,
      "type": "header",
      "text": "Basic configuration",
      "size": 2,
      "sm": 12
    },
    "alias": {
      "type": "text",
      "label": "Name",
      "tooltip": "Name help",
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "outputId": {
      "type": "text",
      "label": "Output ID",
      "tooltip": "Output ID help",
      "noMultiEdit": true,
      "defaultFunc": "customObj && customObj._id ? customObj._id.split('.').join('__') : ''",
      "validator": "!data.enabled || (!!data.outputId && !['info', 'priceDefinitions', 'priceHistory', 'basicPriceHistory'].includes(data.outputId) && (/^[A-Za-z0-9_-]{1,128}$/.test(data.outputId) || !!(customObj && customObj._id && data.outputId === customObj._id.split('.').join('__'))) && (!data._usedOutputIds || data._usedOutputIds[data.outputId] === undefined || !!(customObj && customObj._id && (data._usedOutputIds[data.outputId] === customObj._id || data.outputId === customObj._id.split('.').join('__')))))",
      "validatorErrorText": "Output ID format error",
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "selectedPrice": {
      "newLine": true,
      "command": "getPriceDefinitions",
      "type": "autocompleteSendTo",
      "label": "Select price definition",
      "validator": "!data.enabled || (!!data.selectedPrice && data.selectedPrice !== 'Choose')",
      "validatorErrorText": "Price definition required error",
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "selectedUnit": {
      "command": "getUnits",
      "type": "autocompleteSendTo",
      "label": "Select Unit",
      "default": "Detect automatically",
      "validator": "!data.enabled || ['GW', 'GWh', 'MW', 'MWh', 'W', 'Wh', 'cl', 'cm', 'cm³', 'dl', 'dm', 'dm³', 'g', 'hl', 'kW', 'kWh', 'kg', 'km', 'km³', 'l', 'm', 'mW', 'mWh', 'ml', 'mm', 'mm³', 'm³', 'nm', 't', 'µm'].includes(data.selectedUnit && data.selectedUnit !== 'Detect automatically' ? data.selectedUnit : customObj && customObj.common && customObj.common.unit)",
      "validatorErrorText": "Unit required error",
      "xs": 12,
      "sm": 12,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "_usedOutputIds": {
      "type": "text",
      "hidden": true,
      "defaultSendTo": "getUsedOutputIds"
    },
    "_calcSettings": {
      "newLine": true,
      "type": "header",
      "text": "Calculation settings",
      "size": 2,
      "sm": 12
    },
    "costs": {
      "type": "checkbox",
      "label": "Calculate costs",
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "basicRate": {
      "type": "checkbox",
      "label": "Including basic rate",
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "consumption": {
      "type": "checkbox",
      "label": "Calculate consumption",
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "averagePowerValues": {
      "type": "checkbox",
      "label": "Average power values between updates",
      "tooltip": "Average power values help",
      "default": false,
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "ignoreNegativeValues": {
      "type": "checkbox",
      "label": "Ignore negative power values",
      "tooltip": "Ignore negative power values help",
      "default": false,
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "meter_values": {
      "type": "checkbox",
      "label": "Store Meter Values",
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "deviceResetLogicEnabled": {
      "type": "checkbox",
      "label": "Enable device value reset detection",
      "default": true,
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "threshold": {
      "type": "number",
      "label": "threshold",
      "help": "Threshold value of device reset detection",
      "default": 1,
      "min": 0,
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "decimalsQuantity": {
      "type": "number",
      "label": "Decimals for consumption values",
      "help": "Individual rounding decimals help",
      "min": -1,
      "max": 15,
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "decimalsCosts": {
      "type": "number",
      "label": "Decimals for cost values",
      "help": "Individual rounding decimals help",
      "min": -1,
      "max": 15,
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "_startValues": {
      "newLine": true,
      "type": "header",
      "text": "Start values for the respective period, unit scale (e.g. Wh or kWh) must match the target unit!",
      "size": 2,
      "sm": 12
    },
    "start_day": {
      "type": "number",
      "label": "Day",
      "help": "Meter reading at the beginning of the day",
      "default": 0,
      "min": 0,
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "start_week": {
      "type": "number",
      "label": "Week",
      "help": "Meter reading at the beginning of the week",
      "default": 0,
      "min": 0,
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "start_month": {
      "type": "number",
      "label": "Month",
      "help": "Meter reading at the beginning of the month",
      "default": 0,
      "min": 0,
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "start_quarter": {
      "type": "number",
      "label": "Quarter",
      "help": "Meter reading at the beginning of the quarter",
      "default": 0,
      "min": 0,
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6
    },
    "start_year": {
      "type": "number",
      "label": "Year",
      "help": "Meter reading at the beginning of the year",
      "default": 0,
      "min": 0,
      "xs": 12,
      "sm": 6,
      "md": 6,
      "lg": 6,
      "xl": 6
    }
  }
}
