{
  "i18n": true,
  "type": "panel",
  "items": {
    "_settingsHint": {
      "newLine": true,
      "type": "staticText",
      "text": "Custom settings moved hint",
      "xs": 12,
      "sm": 12,
      "md": 12,
      "lg": 12,
      "xl": 12
    },
    "_openSettings": {
      "newLine": true,
      "type": "staticText",
      "text": "Open SourceAnalytix settings",
      "href": "_overview",
      "button": true,
      "variant": "contained",
      "color": "primary",
      "xs": 12,
      "sm": 6,
      "md": 4,
      "lg": 4,
      "xl": 4
    },
    "consumption": {
      "type": "checkbox",
      "default": true,
      "hidden": "true"
    },
    "costs": {
      "type": "checkbox",
      "default": true,
      "hidden": "true"
    },
    "meter_values": {
      "type": "checkbox",
      "default": true,
      "hidden": "true"
    },
    "deviceResetLogicEnabled": {
      "type": "checkbox",
      "default": true,
      "hidden": "true"
    },
    "threshold": {
      "type": "number",
      "default": 1,
      "hidden": "true"
    }
  }
}
